# Generate a unique signing key with at least 32 bytes.
JWT_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017/nivora
PORT=3000
BIND_HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Additional browser or native origins, separated by commas.
ALLOWED_ORIGINS=
# Enable only behind a trusted reverse proxy.
TRUST_PROXY_HOPS=0

# Optional SMTP and contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_EMAIL=

# Optional Google sign-in. Set the exact callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

BASE_URL=http://localhost:3000
# Mount a persistent private directory, or store uploads in MongoDB with UPLOAD_STORAGE=mongo.
PRIVATE_UPLOAD_DIR=
UPLOAD_STORAGE=
